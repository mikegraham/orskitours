<metadata><name>Snowlands 1311 Devils Dance Floor</name><desc>out and back to waypoint 11. 13.2 miles round trip. Line traced from Marcus Libkind's map, tours.snowlands.org/tours/13/1311_tour.htm</desc></metadata>
<wpt lat="37.760774" lon="-119.80239"><ele>1896.16</ele><name>1311-01 trailhead</name></wpt>
<wpt lat="37.759664" lon="-119.797175"><ele>1926.11</ele><name>1311-02 Old Big Oak Flat Road</name></wpt>
<wpt lat="37.765353" lon="-119.774375"><ele>2143.1</ele><name>1311-03 southwest end of Gin Flat</name></wpt>
<wpt lat="37.76265" lon="-119.756414"><ele>2105.76</ele><name>1311-04 road exits the woods just east of Peak 7069</name></wpt>
<wpt lat="37.761487" lon="-119.753748"><ele>2081.41</ele><name>1311-05 location where you must consciously turn south</name></wpt>
<wpt lat="37.75443" lon="-119.746597"><ele>2028.71</ele><name>1311-06 location where you must turn south to continue on the ridge</name></wpt>
<wpt lat="37.747267" lon="-119.746696"><ele>2017.75</ele><name>1311-07 location where the ridge drops abruptly</name></wpt>
<wpt lat="37.747231" lon="-119.74206"><ele>1969.34</ele><name>1311-08 very small saddle</name></wpt>
<wpt lat="37.745879" lon="-119.738951"><ele>2011.5</ele><name>1311-09 level and open terrain</name></wpt>
<wpt lat="37.7424" lon="-119.738532"><ele>1998.83</ele><name>1311-10 very small saddle at the base of Devils Dance Floor</name></wpt>
<wpt lat="37.739142" lon="-119.735813"><ele>2080.65</ele><name>1311-11 summit of Devils Dance Floor</name></wpt>
<trk><name>Snowlands 1311 Devils Dance Floor</name>
