<wpt lat="39.344772" lon="-119.863158"><ele>2151.05</ele><name>0617-03 top of an obvious ski run</name></wpt>
<wpt lat="39.349045" lon="-119.863425"><ele>2035.91</ele><name>0617-04 water tank</name></wpt>
<wpt lat="39.359471" lon="-119.85878"><ele>1907.12</ele><name>0617-05 north entrance trailhead</name></wpt>
<wpt lat="39.35438" lon="-119.858337"><ele>1923.97</ele><name>0617-06 bridge across Galena Creek</name></wpt>
