<wpt lat="37.972686" lon="-119.242195"><ele>3039.6</ele><name>1806-03 location where the terrain is less steep</name></wpt>
<wpt lat="37.981236" lon="-119.242727"><ele>3128.65</ele><name>1806-04 bowl</name></wpt>
<wpt lat="37.964221" lon="-119.228412"><ele>3126.0</ele><name>1806-05 Peak 10250</name></wpt>
