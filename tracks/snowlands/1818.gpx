<wpt lat="37.872144" lon="-118.862264"><ele>2559.72</ele><name>1818-03 saddle</name></wpt>
<wpt lat="37.869424" lon="-118.857797"><ele>2542.89</ele><name>1818-04 center of Sagehen Meadows</name></wpt>
<wpt lat="37.847967" lon="-118.843544"><ele>2753.04</ele><name>1818-05 saddle</name></wpt>
<wpt lat="37.85274" lon="-118.841576"><ele>2795.07</ele><name>1818-06 summit of Sagehen Peak</name></wpt>
<wpt lat="37.846138" lon="-118.84808"><ele>2833.93</ele><name>1818-07 summit of Crooked Peak</name></wpt>
<trk><name>Snowlands 1818 Sagehen Peak and Crooked Peak</name>
