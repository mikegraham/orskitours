<metadata><name>Snowlands 0605 Tahoe Meadows to Incline Village</name><desc>one way. 4.2 miles one-way. Line traced from Marcus Libkind's map, tours.snowlands.org/tours/06/0605_tour.htm</desc></metadata>
<wpt lat="39.294703" lon="-119.923026"><ele>2580.92</ele><name>0605-01 trailhead</name></wpt>
<wpt lat="39.293526" lon="-119.920108"><ele>2606.12</ele><name>0605-02 trees on the opposite side</name></wpt>
<wpt lat="39.293432" lon="-119.910851"><ele>2664.04</ele><name>0605-03 less wooded area that ascends to the south</name></wpt>
<wpt lat="39.291343" lon="-119.909534"><ele>2717.8</ele><name>0605-04 ridgetop and more level terrain</name></wpt>
<wpt lat="39.292574" lon="-119.904248"><ele>2724.65</ele><name>0605-05 broad saddle</name></wpt>
<wpt lat="39.275766" lon="-119.914267"><ele>2409.14</ele><name>0605-06 drainage narrows and drops abruptly</name></wpt>
