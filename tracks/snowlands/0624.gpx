<metadata><name>Snowlands 0624 Ophir Creek and Peak 8843</name><desc>loop + spur to 4. 2.8 miles round trip. Line traced from Marcus Libkind's map, tours.snowlands.org/tours/06/0624_tour.htm</desc></metadata>
<wpt lat="39.302106" lon="-119.918525"><ele>2607.47</ele><name>0624-01 trailhead</name></wpt>
<wpt lat="39.299447" lon="-119.906847"><ele>2575.38</ele><name>0624-02 trees that divide the path ahead into two possible routes</name></wpt>
<wpt lat="39.299358" lon="-119.902573"><ele>2562.1</ele><name>0624-03 mileage point</name></wpt>
<wpt lat="39.30094" lon="-119.898371"><ele>2558.67</ele><name>0624-04 point where the creek drops abruptly as it continues east</name></wpt>
<wpt lat="39.299979" lon="-119.904666"><ele>2571.64</ele><name>0624-05 point from which you can easily ascend north to Peak 8843</name></wpt>
<wpt lat="39.303757" lon="-119.902881"><ele>2686.45</ele><name>0624-06 summit of Peak 8843</name></wpt>
<wpt lat="39.300849" lon="-119.907212"><ele>2587.56</ele><name>0624-07 level terrain</name></wpt>
