<metadata><name>Snowlands 0326 Schallenberger Ridge</name><desc>out and back to waypoint 7. 5.0 miles round trip. Line traced from Marcus Libkind's map, tours.snowlands.org/tours/03/0326_tour.htm</desc></metadata>
<wpt lat="39.318768" lon="-120.2313"><ele>1811.12</ele><name>0326-01 trailhead</name></wpt>
<wpt lat="39.314972" lon="-120.23177"><ele>1845.82</ele><name>0326-02 road levels after a short but steep section</name></wpt>
<wpt lat="39.314776" lon="-120.241485"><ele>1974.65</ele><name>0326-03 road that crosses the ridge</name></wpt>
<wpt lat="39.312647" lon="-120.252653"><ele>2131.95</ele><name>0326-04 terrain becomes significantly less steep</name></wpt>
<wpt lat="39.31039" lon="-120.258727"><ele>2153.32</ele><name>0326-05 location where the terrain begins to climb more steeply</name></wpt>
<wpt lat="39.310318" lon="-120.263448"><ele>2183.2</ele><name>0326-06 north spur of Peak 7469</name></wpt>
<wpt lat="39.306316" lon="-120.26596"><ele>2274.34</ele><name>0326-07 summit of Peak 7469</name></wpt>
