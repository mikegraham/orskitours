<metadata><name>Snowlands 1071 Tragedy Spring to Maidens Grave</name><desc>one way. 3.1 miles one-way. Line traced from Marcus Libkind's map, tours.snowlands.org/tours/10/1071_tour.htm</desc></metadata>
<wpt lat="38.637841" lon="-120.141932"><ele>2421.07</ele><name>1071-01 trailhead</name></wpt>
<wpt lat="38.638609" lon="-120.143341"><ele>2408.93</ele><name>1071-02 location where you can easily leave the road to the north</name></wpt>
<wpt lat="38.640723" lon="-120.142923"><ele>2434.43</ele><name>1071-03 saddle</name></wpt>
<wpt lat="38.641062" lon="-120.15342"><ele>2471.33</ele><name>1071-04 Peak 8096</name></wpt>
<wpt lat="38.646654" lon="-120.161749"><ele>2318.23</ele><name>1071-05 Peak 7617</name></wpt>
<wpt lat="38.64577" lon="-120.160947"><ele>2313.29</ele><name>1071-06 location where you can descend to the southwest</name></wpt>
<wpt lat="38.642093" lon="-120.168882"><ele>2193.66</ele><name>1071-07 location where it is convenient to cross the creek and traverse to the south</name></wpt>
<wpt lat="38.634871" lon="-120.170704"><ele>2244.52</ele><name>1071-08 location where you can cross the small drainage and continue to the southwest</name></wpt>
<wpt lat="38.633059" lon="-120.174452"><ele>2319.77</ele><name>1071-09 snow-covered road at the base of a steep slope</name></wpt>
<wpt lat="38.633167" lon="-120.176984"><ele>2336.93</ele><name>1071-10 end point</name></wpt>
