<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="book_route.py" xmlns="http://www.topografix.com/GPX/1/1">
<metadata><name>Sisu Loop (from Trillium Lake Sno-Park)</name><desc>or-vielbig-2e:150-3: route read from the book's text and sketch map. One trkseg per waypoint pair, in order; segment sources are in the trk desc. Geometry from OSM (ODbL, (c) OpenStreetMap contributors) and USFS EDW (public domain) where marked; 'straight' segments are off-trail connectors, not traced.</desc></metadata>
<wpt lat="45.285259" lon="-121.727970"><ele>1156.8</ele><name>Trillium Lake Sno-Park</name><desc>source: DB trailhead pin th:trillium-lake-sno-park (OSM parking way/148019331); confidence: high; pdf_page: 143; book_elev_ft: 3830</desc></wpt>
<wpt lat="45.280208" lon="-121.733236"><ele>1103.1</ele><name>Airstrip junction</name><desc>source: as in or-vielbig-2e_147-4; confidence: high; pdf_page: 144</desc></wpt>
<wpt lat="45.270371" lon="-121.732742"><ele>1103.9</ele><name>Campground junction</name><desc>source: OSM node 37397443, as in or-vielbig-2e_147-4; confidence: high; pdf_page: 146</desc></wpt>
<wpt lat="45.265815" lon="-121.737354"><ele>1102.8</ele><name>Junction east of the dam (2656 / 2612)</name><desc>source: OSM node 37598353, as in or-vielbig-2e_143-1; confidence: high; pdf_page: 147</desc></wpt>
<wpt lat="45.255703" lon="-121.751365"><ele>1084.4</ele><name>Quarry Junction</name><desc>source: OSM node 37303540, where the Forest Road 2656 track (Valhalla Trail road) leaves the Trillium Lake Loop Road (Lower Ridge road); 1.08 mi from the dam junction vs map 33's 0.9 + 0.1; DEM 3,558 ft vs the book's 3,560; confidence: high; pdf_page: 152; book_elev_ft: 3560; quote: Ski to Quarry Junction and keep right at the junction, skiing the right branch, the Valhalla Trail road.</desc></wpt>
<wpt lat="45.244000" lon="-121.768600"><ele>1096.5</ele><name>Top of Finnlander Hill</name><desc>source: Forest Road 2656 track 1.3 mi from Quarry Junction; DEM 3,597 ft (map 33 spot height 3580' just south); confidence: medium; pdf_page: 152; quote: 1.3 miles from Quarry Junction reach the top of Finnlander Hill ... The narrow, straight-sided clearcut descends gently to the edge of Mud Creek, 0.5 mile below the Valhalla Trail road.</desc></wpt>
<wpt lat="45.237800" lon="-121.762000"><ele>1030.1</ele><name>Mud Creek crossing</name><desc>source: on OSM stream way/546769895 Mud Creek, 0.53 mi SE of the hilltop, about 150 m north of the Salmon River road; DEM 3,380 ft; confidence: low; pdf_page: 152; quote: Logs provide safe but exciting crossings of the narrow, shallow creek.</desc></wpt>
<wpt lat="45.236100" lon="-121.761000"><ele>1036.4</ele><name>Salmon River road</name><desc>source: OSM Forest Road 309 (the book's Salmon River road) where it runs east-west south of the creek; confidence: medium; pdf_page: 153; quote: Once across, ski up to the Salmon River road and turn left (east) to the foot of Highline Cutoff Hill.</desc></wpt>
<wpt lat="45.236400" lon="-121.757500"><ele>1039.5</ele><name>Foot of Highline Cutoff Hill (far corner)</name><desc>source: OSM Forest Road 309 at the east end of its east-west stretch, before it turns north; confidence: low; pdf_page: 153; quote: Do not ascend this clearcut, but from its lower, far corner ascend a narrow clearcut upward 0.5 mile to the Lower Ridge road.</desc></wpt>
<wpt lat="45.234500" lon="-121.749500"><ele>1107.0</ele><name>Lower Ridge road (top of the narrow clearcut)</name><desc>source: Trillium Lake Loop Road (Lower Ridge road) about 0.7 mi south of the Jefferson View Cutoff, as map 33's dotted 0.5 lands; DEM 3,632 ft (map 3600' just south); confidence: low; pdf_page: 147</desc></wpt>
<wpt lat="45.240115" lon="-121.746968"><ele>1097.4</ele><name>Jefferson View Cutoff (lower end)</name><desc>source: OSM node 2452545072, where unnamed track way/237337446 leaves the Loop Road north-east toward the viewpoint; confidence: medium; pdf_page: 153; quote: Here turn left to the Jefferson View Cutoff route to Jefferson Viewpoint</desc></wpt>
<wpt lat="45.242187" lon="-121.739917"><ele>1139.3</ele><name>Jefferson View Cutoff (upper end)</name><desc>source: OSM node 2452545090, end of track way/237337446 in the Telemark Hill clearcut; confidence: medium; pdf_page: 147</desc></wpt>
<wpt lat="45.247437" lon="-121.738521"><ele>1193.3</ele><name>Jefferson Viewpoint</name><desc>source: OSM Trillium Lake Loop Road node 37598739, as in or-vielbig-2e_150-2; DEM 3,915 ft; confidence: medium; pdf_page: 146; book_elev_ft: 3940</desc></wpt>
<wpt lat="45.270371" lon="-121.732742"><ele>1103.9</ele><name>Campground junction (return)</name><desc>source: as above; confidence: high; pdf_page: 153; quote: continue north to the campground junction east of Trillium Lake</desc></wpt>
<wpt lat="45.280208" lon="-121.733236"><ele>1103.1</ele><name>Airstrip junction (return)</name><desc>source: as above; confidence: high</desc></wpt>
<wpt lat="45.285259" lon="-121.727970"><ele>1156.8</ele><name>Trillium Lake Sno-Park (finish)</name><desc>source: as start; confidence: high</desc></wpt>
