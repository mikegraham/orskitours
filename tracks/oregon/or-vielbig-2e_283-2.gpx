<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="book_route.py" xmlns="http://www.topografix.com/GPX/1/1">
<metadata><name>Big Obsidian Lava Flow from Ten-Mile Sno-Park</name><desc>or-vielbig-2e:283-2: route read from the book's text and sketch map. One trkseg per waypoint pair, in order; segment sources are in the trk desc. Geometry from OSM (ODbL, (c) OpenStreetMap contributors) and USFS EDW (public domain) where marked; 'straight' segments are off-trail connectors, not traced.</desc></metadata>
<wpt lat="43.707204" lon="-121.326816"><ele>1702.7</ele><name>Ten-Mile Sno-Park</name><desc>source: DB trailhead pin (OSM way 306294846 Ten Mile Sno-Park), as in 282-3; confidence: high; pdf_page: 283; book_elev_ft: 5600; quote: map 64: TEN-MILE SNO-PARK 5600'</desc></wpt>
<wpt lat="43.712347" lon="-121.277964"><ele>1934.6</ele><name>Paulina Lake outlet (road 21 bridge)</name><desc>source: OSM road 21 node 38373784, as in 282-3; confidence: medium; pdf_page: 285; book_elev_ft: 6331; quote: the Big Flow is 2.2 miles from the resort area and 5.7 miles from Ten-Mile Sno-Park</desc></wpt>
<wpt lat="43.707000" lon="-121.238500"><ele>1945.7</ele><name>Foot of the flow at road 21</name><desc>source: north tip of OSM way 240055270 Big Obsidian Flow beside road 21, west of the Big Obsidian Flow Trailhead; confidence: medium; pdf_page: 285; quote: ski the Paulina Lake road (toward East Lake) to the foot of the obvious, open, 100-foot-high face of the flow beside the road</desc></wpt>
<wpt lat="43.705800" lon="-121.243300"><ele>1952.8</ele><name>Northwest edge of the flow</name><desc>source: keeps the straight leg outside the OSM flow outline (way 240055270); confidence: low; pdf_page: 286</desc></wpt>
<wpt lat="43.702000" lon="-121.246200"><ele>1960.2</ele><name>West moat</name><desc>source: about 80 m outside the flow's west edge (OSM way 240055270); confidence: medium; pdf_page: 286; quote: turn right at the base of the flow near the road and ski along the edge westward then southward; it soon becomes a moat</desc></wpt>
<wpt lat="43.696000" lon="-121.247000"><ele>1983.8</ele><name>Foot of The Step</name><desc>source: flow's west edge; DEM climbs 270 ft from here to the next point; confidence: medium; pdf_page: 286; quote: a steep, 300-foot climb on the west side called The Step</desc></wpt>
<wpt lat="43.692500" lon="-121.244800"><ele>2065.8</ele><name>Top of The Step</name><desc>source: flow's west edge, DEM 6778 ft; confidence: medium; pdf_page: 286; quote: At its top, the grade returns to moderate, and the moat becomes sinuous and scenic</desc></wpt>
<wpt lat="43.689500" lon="-121.242800"><ele>2098.6</ele><name>Southwest moat</name><desc>source: outside the flow's southwest edge; confidence: low; pdf_page: 286; quote: the moat becomes sinuous and scenic</desc></wpt>
<wpt lat="43.686200" lon="-121.239500"><ele>2154.2</ele><name>South-west tip moat</name><desc>source: keeps the straight leg outside the OSM flow outline (way 240055270); confidence: low; pdf_page: 286</desc></wpt>
<wpt lat="43.685000" lon="-121.235000"><ele>2159.6</ele><name>South moat</name><desc>source: outside the flow's south edge, DEM 7085 ft; confidence: low; pdf_page: 286</desc></wpt>
<wpt lat="43.683800" lon="-121.232500"><ele>2212.4</ele><name>South edge moat</name><desc>source: keeps the straight leg outside the OSM flow outline (way 240055270); confidence: low; pdf_page: 286</desc></wpt>
<wpt lat="43.684200" lon="-121.229600"><ele>2171.9</ele><name>El Capitan (base of the cliff)</name><desc>source: just outside the flow's south tip (OSM way 240055270), DEM 7126 ft; map 64 puts El Capitan at the flow's south end; confidence: low; pdf_page: 286; book_elev_ft: 7100; quote: At El Capitan, a vertical wall blocking the moat, scramble easily around the base of the cliff to almost level progress at 7,100 feet</desc></wpt>
<wpt lat="43.685800" lon="-121.224500"><ele>2197.6</ele><name>Round the south-east tip</name><desc>source: keeps the straight leg outside the OSM flow outline (way 240055270); confidence: low; pdf_page: 286</desc></wpt>
<wpt lat="43.688000" lon="-121.223200"><ele>2166.7</ele><name>The Valley</name><desc>source: east of the flow's south-east lobe, DEM 7115 ft; confidence: medium; pdf_page: 286; book_elev_ft: 7100; quote: As you turn northward, enter a deep, beautiful snow valley</desc></wpt>
<wpt lat="43.692000" lon="-121.226500"><ele>2192.4</ele><name>Obsidian Pass</name><desc>source: head of the valley where Lost Lake Trail #3958.2 turns east; DEM 7193 ft; confidence: medium; pdf_page: 286; book_elev_ft: 7200; quote: At the head of the valley is Obsidian Pass (7,200 feet), the high point of the loop</desc></wpt>
<wpt lat="43.696000" lon="-121.227000"><ele>2139.1</ele><name>Bottom of the first drop</name><desc>source: east edge of the flow, DEM 7018 ft, 175 ft below the pass; confidence: low; pdf_page: 286; quote: From the pass, the route drops steeply 300 feet, levels out</desc></wpt>
<wpt lat="43.699500" lon="-121.226800"><ele>2051.4</ele><name>Hell Hole (Lost Lake) south end</name><desc>source: foot of the flow's east face, DEM 6730 ft; Lost Lake Trail #3958.2 runs just east; confidence: medium; pdf_page: 286; quote: the route drops steeply 300 feet, levels out, then takes another breathtaking drop into the south end of the Hell Hole</desc></wpt>
<wpt lat="43.704500" lon="-121.228000"><ele>1973.2</ele><name>Saddle at the north end of the Hell Hole</name><desc>source: north-east corner of the flow by Lost Lake Trail #3958.2; confidence: low; pdf_page: 285; quote: ski to the left around the east side to a nearby saddle ... Here you will see the Hell Hole</desc></wpt>
<wpt lat="43.706000" lon="-121.230500"><ele>1972.5</ele><name>North-east edge of the flow</name><desc>source: keeps the straight leg outside the OSM flow outline (way 240055270); confidence: low; pdf_page: 286</desc></wpt>
<wpt lat="43.706300" lon="-121.233000"><ele>1963.8</ele><name>North edge of the flow</name><desc>source: outside the flow's north edge, between it and road 21; confidence: low; pdf_page: 285</desc></wpt>
<wpt lat="43.707000" lon="-121.238500"><ele>1945.7</ele><name>Foot of the flow at road 21</name><desc>source: loop closes; confidence: medium; pdf_page: 285</desc></wpt>
<wpt lat="43.712347" lon="-121.277964"><ele>1934.6</ele><name>Paulina Lake outlet (road 21 bridge)</name><desc>source: return; confidence: medium; pdf_page: 285</desc></wpt>
<wpt lat="43.707204" lon="-121.326816"><ele>1702.7</ele><name>Ten-Mile Sno-Park</name><desc>source: return; confidence: high; pdf_page: 283; book_elev_ft: 5600</desc></wpt>
